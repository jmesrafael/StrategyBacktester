# Daily "did the lab bot do what ITS OWN backtest says it should have, on the same candles?" (compare-live-vs-backtest.js: public GET requests only, no keys, no orders).
# BB-Trail is judged only against the bb-trail backtest: it shares bb-core's entry rule but holds trades for weeks, so its trades are NOT expected to match bb-core's.
# Writes /var/lib/bbtrail/audit/compare-<date>.json and .txt and pushes the summary to the dashboard (if configured).
# Exit 1 = not a match (an investigation item, not a failure of this unit), 2 = could not run (e.g. no journal yet on a fresh install).
[Unit]
Description=BB-Trail lab vs its own backtest (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=bbtrail
Group=bbtrail
WorkingDirectory=/opt/bbtrail
ExecStart=/usr/bin/node /opt/bbtrail/compare-live-vs-backtest.js --mode paper --tolerance 0.15 --rel-tolerance 0.05 --out-dir /var/lib/bbtrail/audit --push --quiet
SuccessExitStatus=1 2
TimeoutStartSec=300
Nice=10
Environment=TZ=UTC
Environment=ICORE_STATE_DIR=/var/lib/bbtrail
Environment=ICORE_KEYS=/var/lib/bbtrail/no-keys.json
EnvironmentFile=-/etc/bbtrail.env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bbtrail
InaccessiblePaths=-/opt/lucidio -/opt/icore -/opt/lucidio-1h -/etc/lucidio -/etc/icore -/etc/lucidio-1h.env -/var/backups
