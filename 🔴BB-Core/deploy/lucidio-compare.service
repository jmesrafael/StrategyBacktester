# Daily "did the bot do what the backtester says it should have?" check: compare-live-vs-backtest.js (public GET requests only, no keys, no orders).
# Writes /opt/lucidio/audit/out/compare-<date>.json and .txt and pushes the summary to the dashboard (if configured).
# Exit code 1 = not a match (an investigation item, not a failure of this unit), 2 = the comparison itself could not run.
[Unit]
Description=Lucid'io live-vs-backtest comparison (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lucidio
Group=lucidio
WorkingDirectory=/opt/lucidio
ExecStart=/usr/bin/node /opt/lucidio/compare-live-vs-backtest.js --push --quiet
SuccessExitStatus=1
TimeoutStartSec=300
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/lucidio
