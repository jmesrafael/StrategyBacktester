# systemd unit for Lucid'io on the VPS (Ubuntu 22.04 / 24.04). Installed (and refreshed) by deploy/setup-vps.sh.
#   sudo systemctl status lucidio      sudo journalctl -u lucidio -f      sudo systemctl restart lucidio
# LIVE trading additionally needs LUCIDIO_ALLOW_LIVE=1 (a systemd drop-in, see DEPLOY.md). Paper needs nothing.
[Unit]
Description=Lucid'io bot (MEXC futures)
After=network-online.target time-sync.target
Wants=network-online.target
# crash loop guard: more than 20 starts in 10 minutes -> the unit stays "failed" (and lucidio-failed.service alerts) instead of hammering MEXC
StartLimitIntervalSec=600
StartLimitBurst=20
OnFailure=lucidio-failed.service

[Service]
Type=simple
User=lucidio
Group=lucidio
WorkingDirectory=/opt/lucidio
ExecStart=/usr/bin/node /opt/lucidio/lucidio.js loop
Restart=always
RestartSec=15
# a stopped bot leaves positions protected by their stop/target on MEXC; it re-checks everything on start (SIGTERM is handled: logs "stopped")
KillSignal=SIGTERM
TimeoutStopSec=30
# measured peak of the bot code incl. a 6-year replay: ~80 MB. High = start reclaiming (throttle), Max = hard kill (systemd then restarts it)
MemoryHigh=300M
MemoryMax=450M
Environment=NODE_ENV=production
Environment=TZ=UTC
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/lucidio

[Install]
WantedBy=multi-user.target
