# Lucid'io shadow recorder: a READ-ONLY sidecar that records every finished 4h candle (public market data only) next to the live bot.
# Installed by deploy/install-shadow.sh. It has its own user, its own code copy (/opt/lucidio-shadow, owned by root) and its own data folder
# (/var/lib/lucidio-shadow). The bot's folder, keys, state and journal are invisible to it, and nothing is shared with the bot's service:
# starting, stopping, crashing or killing this unit cannot change what the bot does.
#   sudo systemctl status lucidio-shadow      sudo journalctl -u lucidio-shadow -f      sudo cat /var/lib/lucidio-shadow/status.json
[Unit]
Description=Lucid'io shadow recorder (read-only, public market data)
After=network-online.target time-sync.target
Wants=network-online.target
# crash loop guard: more than 20 starts in 10 minutes -> the unit stays failed instead of hammering the exchanges
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=lucidio-shadow
Group=lucidio-shadow
WorkingDirectory=/opt/lucidio-shadow
ExecStart=/usr/bin/node /opt/lucidio-shadow/shadow-recorder.js loop
Restart=always
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=15
SyslogIdentifier=lucidio-shadow
Environment=NODE_ENV=production
Environment=TZ=UTC
Environment=SHADOW_DIR=/var/lib/lucidio-shadow
Environment=SHADOW_COINS=SOL,ZEC
# disk limits: gzip files older than a day, delete the oldest files while the folder is over 300 MB, stop writing below 500 MB of free disk
Environment=SHADOW_MAX_MB=300
Environment=SHADOW_GZIP_AFTER_DAYS=1
Environment=SHADOW_MIN_FREE_MB=500
# small and polite: it must never compete with the bot
MemoryHigh=150M
MemoryMax=250M
Nice=10
CPUQuota=25%
# world-readable output (public market data only), so the bot's daily compare job can read it; the recorder cannot read anything of the bot's
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/lucidio-shadow
InaccessiblePaths=/opt/lucidio /var/backups /etc/lucidio

[Install]
WantedBy=multi-user.target
