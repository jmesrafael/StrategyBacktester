# Started by OnFailure= of lucidio.service (crash loop hit the start limit, or the service otherwise ended up "failed"): one Telegram message.
[Unit]
Description=Lucid'io: tell the phone that lucidio.service failed

[Service]
Type=oneshot
User=lucidio
Group=lucidio
WorkingDirectory=/opt/lucidio
ExecStart=/usr/bin/node /opt/lucidio/deploy/watchdog.js --notify "lucidio.service entered FAILED state - the bot is NOT running. Check: journalctl -u lucidio -n 50"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
