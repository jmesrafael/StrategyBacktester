# Lucid'io server env file. setup-vps.sh copies this to /opt/lucidio/.env (owner lucidio, chmod 600). Edit it there, then: sudo systemctl restart lucidio
# Values are never printed or logged. An empty value = that feature is off.

# --- Telegram alerts: create the bot with @BotFather (/newbot), press Start on it, then run: node lucidio.js telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Hosted dashboard (Vercel). Both must be set, the secret must equal DASHBOARD_PUSH_SECRET in Vercel. See dashboard/README.md
DASHBOARD_URL=
DASHBOARD_PUSH_SECRET=
# Real MEXC equity and dollar P&L stay off the dashboard in live mode unless you set this to true:
# DASHBOARD_SHARE_LIVE_EQUITY=true
