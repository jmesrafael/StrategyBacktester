# BB-CORE COIN LAB PAPER bot on ARB (simulated money, no orders, no Telegram), next to the live bots, sharing nothing with them.
# Installed by deploy/install-coin-lab.sh. Its own user, code in /opt/coinbb (owned by root), data in /var/lib/coinbb. Dashboard tag: cbb.
#   sudo systemctl status coinbb      sudo journalctl -u coinbb -f      sudo bash /opt/coinbb/deploy/status.sh coinbb
[Unit]
Description=BB-CORE COIN LAB PAPER bot on ARB (simulated, no orders, no Telegram)
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=coinbb
Group=coinbb
WorkingDirectory=/opt/coinbb
ExecStart=/usr/bin/node /opt/coinbb/lucidio.js loop
Restart=always
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=coinbb
Environment=NODE_ENV=production
Environment=TZ=UTC
Environment=LUCIDIO_STATE_DIR=/var/lib/coinbb
# no key file exists at these paths: the bot can never read an account or sign a request; no <app>/.env is read either
Environment=LUCIDIO_KEYS=/var/lib/coinbb/no-keys.json
Environment=LUCIDIO_ENV_FILE=/var/lib/coinbb/no-env-file
# Telegram is removed in the code (send() never reaches the network); this switch is a second lock
Environment=LUCIDIO_NO_NOTIFY=1
# Dashboard: reports as its own bot (cbb) and never answers "Ask bot now" (that is for the live bots).
# DASHBOARD_URL and DASHBOARD_PUSH_SECRET come from /etc/coinbb.env (root only). Without them nothing is pushed and the bot works the same.
Environment=DASHBOARD_ASK_POLL_SEC=0
EnvironmentFile=-/etc/coinbb.env
# measured slippage written by the data recorder (read only); absent = the bot uses the live order book instead
Environment=LUCIDIO_RECORDER_SUMMARY=/var/lib/lucidio-recorder/summary/slippage.json
# it must never compete with the live bots
MemoryHigh=150M
MemoryMax=200M
Nice=10
CPUQuota=20%
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=/var/lib/coinbb
InaccessiblePaths=-/opt/lucidio -/opt/icore -/opt/tcore -/opt/bbtrail -/opt/lucidio-1h -/etc/lucidio -/etc/icore -/etc/tcore -/etc/tcore.env -/etc/bbtrail.env -/etc/lucidio-1h.env -/etc/lucidio-recorder.env -/var/lib/lucidio -/var/lib/icore -/var/lib/tcore -/var/lib/bbtrail -/var/lib/lucidio-1h -/var/backups -/opt/newsbb -/opt/newsic -/opt/newstc -/var/lib/newsbb -/var/lib/newsic -/var/lib/newstc -/etc/newsbb.env -/etc/newsic.env -/etc/newstc.env -/opt/cointc -/var/lib/cointc -/etc/cointc.env

[Install]
WantedBy=multi-user.target
